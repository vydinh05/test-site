<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VEEMORII</title>
    <link rel="icon" type="image/png" href="https://files.catbox.moe/po6m6f.png">
  <link href="https://fonts.googleapis.com/css2?family=VT323&display=swap" rel="stylesheet">
    
    <style>
    body{
      font-family: 'VT323', Comic Sans MS, comic sans;
      color: white;
      background-image: url('https://files.catbox.moe/5y5emm.jpeg');
      background-repeat: no-repeat;
      background-attachment: fixed;
      background-size: cover;
      cursor: url('https://files.catbox.moe/bjpfx4.png'), auto;
      margin: 0;
      padding: 0;
      height: 100vh;
      overflow: hidden;
    }
    
    body:default{
      cursor: url('https://files.catbox.moe/bjpfx4.png'), auto;
    }
    
    a:hover,
    button:hover,
    .img-button:hover,
    .me:hover{
      cursor: url('https://files.catbox.moe/c79fro.png') 5 5, auto;
    }
    
    .button-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
      align-items: flex-end;
      margin-right: 27%;
      margin-top: 9%;
      position: relative;
      z-index: 2;
     
     
    }
    
    .img-button {
      position: relative;
      width: 200px;
      height: 80px;
      cursor: pointer;
      display: block;
    }

    .img-button img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      transition: opacity 0.3s ease;
    }

    .img-button .hover {
      opacity: 0;
    }

    .img-button:hover .default {
      opacity: 0;
    }

    .img-button:hover .hover {
      opacity: 1;
    }
    
    .me-container {
      position: fixed;
      top: 70px;
      left: 27%;
      width: 350px;
      height: 800px; 
      z-index: 10;
     
      
    }
    
    .me {
      width: 100%;
      height: 100%;
      position: relative;
      
     
    }
    
    .me img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      
    }
    
    .me .hover1 {
      opacity: 0;
    }
    
    .me:hover .default1 {
      opacity: 0;
    }
    
    .me:hover .hover1 {
      opacity: 1;
    }
    
    @keyframes bounce{
      0% { transform: translateY(0px); }
      25% { transform: translateY(-20px); }
      50% { transform: translateY(0px); }
      75% { transform: translateY(-5px); }
      100% { transform: translateY(0px); }
    }
    
    .bounce {
        animation: bounce 0.5s ease;
      }
    
    .hello {
      position: fixed;         
      left: 25%; 
      bottom: 50px;
      width: 50%;
      z-index: 100;
      pointer-events: none;
      font-size: 30px;
      display: flex;
  justify-content: center;
  align-items: center;
  
    }
    
   
    @media (max-width: 900px) {
      .me-container {
        left: 0px;
      }
      
      .hello{
        width: 100%;
        left: 0px;
      }
      
      .button-container {
        margin-right: 0px;
        
      }
      
      
    }
    
    @media (max-width: 400px) {
      .me-container {
        left: -30px;
        width: 250px;
        height: 550px;
        top: 90px;
      }
      
      .hello {
        font-size: 20px;
        margin-top: 90px;
      }
    }
    </style>
  </head>
  <body>
    <div class="button-container">
      <a href="art.html" class="img-button">
        <img src="https://files.catbox.moe/ipgf62.png" class="default" alt="Art">
        <img src="https://files.catbox.moe/n1qgym.png" class="hover" alt="Art Hover">
      </a>
      <a href="projects.html" class="img-button">
        <img src="https://files.catbox.moe/jvhq6r.png" class="default" alt="Projects">
        <img src="https://files.catbox.moe/0lgsgk.png" class="hover" alt="Projects Hover">
      </a>
      <a href="blog.html" class="img-button">
        <img src="https://files.catbox.moe/efo86y.png" class="default" alt="Blog">
        <img src="https://files.catbox.moe/bbjbcc.png" class="hover" alt="Blog Hover">
      </a>
      <a href="about.html" class="img-button">
        <img src="https://files.catbox.moe/om3gqd.png" class="default" alt="About">
        <img src="https://files.catbox.moe/hxp5tj.png" class="hover" alt="About Hover">
      </a>
    </div>
    
    <div class="me-container">
      <div class="me" onclick="clicked()">
        <img src="https://i.postimg.cc/9cwwKgpG/Untitled519-20250907222238.png" class="default1" alt="me">
        <img src="https://i.postimg.cc/RvRCjZqJ/Untitled519-20250913154132.png" class="hover1" alt="me">
      </div>
    </div>
    
    <div class="hello">
    <img src="https://i.postimg.cc/28bmcM2H/Untitled525-20250913212404.png" class="hello" alt="hiii">
    <p id="talk" class="hello" style="top: 65%; text-align:center;">heyy welcome in! anything you wanna see?<br>(a lot is a WIP rn...sry)</p>
    </div>
    
    
<script>
  const meContainer = document.querySelector('.me-container');

  meContainer.addEventListener('click', () => {
    meContainer.classList.add('bounce');

   
    setTimeout(() => {
      meContainer.classList.remove('bounce');
    }, 500); 
  });
  
  function clicked(){
    const randomIndex = Math.floor(Math.random() * messages.length);
    talk.textContent = messages[randomIndex];
  }
  
  
  const messages = [
    "HEHEEHAHAHAH",
    "YEOUCH",
    "*insert tom and jerry scream*",
    "haha that tickles!",
    "poke!",
    "omggg that tickles stoppp",
    "STOP FIGHTINGGGG",
    "ark!",
    "oughhhhh",
    "that one actually got me ogghhh",
    "GET OUT OF MY CASTLE",
    "he burnt my shake :("
    ];
    
    const talk = document.getElementById("talk");
  
</script>


</body>
</html>





